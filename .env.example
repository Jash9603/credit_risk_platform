# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ---- App ----
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---- Paths (relative locally; the compose file overrides these to /app/... in-container) ----
DATA_DIR=./data
MODELS_DIR=./models
ARTIFACTS_DIR=./artifacts

# ---- PostgreSQL (used by talk-to-data; matches the `db` service in docker-compose.yml) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=credit_risk
POSTGRES_USER=credit_risk_app
POSTGRES_PASSWORD=change_me

# ---- LLM (talk-to-data chatbot) ----
# Pick one provider. Only the matching key below needs to be set.
LLM_PROVIDER=groq                # openai | groq | gemini
LLM_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# If true and no key is set for LLM_PROVIDER, the chatbot replays recorded
# real responses for its 5 documented query patterns instead of calling the LLM live.
# Lets an evaluator see working talk-to-data with zero setup.
DEMO_MODE=true

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (consumed by web/ at build time) ----
VITE_API_BASE_URL=http://localhost:8000
