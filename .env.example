# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# ---- App ----
ENVIRONMENT=development          # development | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR

# ---- Paths (relative locally; the compose file overrides these to /app/... in-container) ----
DATA_DIR=./data
MODELS_DIR=./models
ARTIFACTS_DIR=./artifacts

# ---- PostgreSQL (used by talk-to-data; matches the `db` service in docker-compose.yml) ----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=credit_risk
POSTGRES_USER=credit_risk_app
POSTGRES_PASSWORD=change_me

# Production/managed Postgres (e.g. Neon). When set, this replaces all POSTGRES_* fields
# above entirely — used as-is, including its own sslmode. Leave blank for local Docker.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# ---- LLM (talk-to-data chatbot) ----
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# ---- Frontend (consumed by frontend/ at build time) ----
VITE_API_BASE_URL=http://localhost:8000
