# Secrets
.env

# Dataset — never commit. CSVs live in data/, mounted as a Docker volume.
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# NOTE: models/ and artifacts/ are intentionally NOT ignored — the brief lists
# saved model artifacts and EDA charts as required deliverables, so the evaluator
# should see them in the repo without having to retrain or re-run anything.

# Exception: artifacts/cache/ holds regenerated performance-cache files
# (precomputed bureau/previous-application aggregates) — rebuilt automatically.
artifacts/cache/

# Frontend
frontend/node_modules/
frontend/dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Docker
*.log
