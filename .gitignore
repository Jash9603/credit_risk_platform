# Secrets
.env

# Dataset — never commit. CSVs live in data/, mounted as a Docker volume.
data/*
!data/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# NOTE: models/ and artifacts/ are intentionally NOT ignored — the brief lists
# saved model artifacts and EDA charts as required deliverables, so the evaluator
# should see them in the repo without having to retrain or re-run anything.

# artifacts/cache/ holds precomputed bureau/previous-application aggregates (~14MB) —
# rebuilt automatically from the raw CSVs when missing, but committed anyway so the
# production API image (which never ships the multi-GB raw tables) has them without
# needing bureau.csv/previous_application.csv at all.

# Frontend
frontend/node_modules/
frontend/dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Docker
*.log
